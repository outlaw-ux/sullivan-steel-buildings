# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for Preview + Production.

# Resend API key — https://resend.com/api-keys  (Sending access is enough)
RESEND_API_KEY=

# Where quote-request emails are delivered. Comma-separate for multiple.
QUOTE_TO_EMAIL=

# Optional CC on every quote request.
QUOTE_CC_EMAIL=

# Sender shown on the quote email. The address must be on a domain that is
# verified in Resend (sullivansteelbuildings.com).
QUOTE_FROM_EMAIL="Sullivan Steel Buildings <quotes@sullivansteelbuildings.com>"

# Without RESEND_API_KEY and QUOTE_TO_EMAIL set, /api/quote still returns success
# and logs the request to the server console instead of emailing.
